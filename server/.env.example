# Copy to server/.env and adjust as needed. Every value has a sane default,
# so TraceBack runs with no .env file at all.

PORT=4000

# Change this in any deployment — it signs every JWT.
JWT_SECRET=traceback-dev-secret-change-me
JWT_EXPIRY=7d

# SQLite file (created automatically). Point it anywhere writable.
# DB_FILE=./data/traceback.db

# Where uploaded item photos are stored and served from (/uploads/<file>).
# UPLOAD_DIR=./uploads
