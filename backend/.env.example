# ---------------------------------------------------------------------------
# Lost & Found Item Tracker - backend configuration
# Copy to .env and adjust. Every value below has a working default,
# so the app boots with zero configuration for the hackathon demo.
# ---------------------------------------------------------------------------

PORT=4000
NODE_ENV=development

# Public URL of this API (used to build absolute image URLs)
PUBLIC_URL=http://localhost:4000

# Comma separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173,http://localhost:4000

# --- Auth -------------------------------------------------------------------
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# Restrict registration to a college domain (advanced feature).
# Leave empty to allow any email address.
ALLOWED_EMAIL_DOMAINS=

# --- Database ---------------------------------------------------------------
# sqlite (default, zero-config) | postgres
DB_CLIENT=sqlite
SQLITE_FILE=./data/lostfound.db

# Used when DB_CLIENT=postgres
DATABASE_URL=postgres://lostfound:lostfound@localhost:5432/lostfound

# --- Image storage ----------------------------------------------------------
# local (default, saves to ./uploads) | cloudinary
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Matching engine --------------------------------------------------------
# Weights must sum to 1.0 (spec section 6)
MATCH_WEIGHT_CATEGORY=0.25
MATCH_WEIGHT_DESCRIPTION=0.25
MATCH_WEIGHT_LOCATION=0.20
MATCH_WEIGHT_TIME=0.15
MATCH_WEIGHT_IMAGE=0.15

# Minimum score (0-100) required before a match row is stored
MATCH_MIN_SCORE=45
# Score at or above which the users get a "strong match" notification
MATCH_STRONG_SCORE=75
# Days after which date proximity contributes nothing
MATCH_DATE_WINDOW_DAYS=14

# --- Optional Python AI matching service (Phase 9) --------------------------
AI_SERVICE_ENABLED=false
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=2500
